# memoryd as a systemd user unit (org.quire.Memory1 on the session bus).
#
# It needs no network (the bus is a unix socket; inferd is another daemon behind the bus) and
# writes only the memory directories. The lines that give it a private view of the file system
# and the network (no network, a read-only system, writes only to the memory directories) are in
# memoryd.service.d/sandbox.conf, because some systems refuse them to user units; see there. What
# stays here needs no namespace. memoryd also applies a Landlock policy to itself (the same
# directories, the session bus socket, nothing else), so with or without the drop-in, and outside
# systemd, the daemon is confined by the kernel all the same.
#
# Forget (ALM-18) scrubs the live files only. Keep ~/.local/share/quire/memory out of snapshots
# and backups. The way that works on every file system: list it in the snapshot tool's and the
# backup tool's excludes. On btrfs (the Fedora default; Ubuntu uses ext4) you can instead make it
# its own subvolume, since a snapshot of the parent does not descend into it. A systemd unit
# cannot do either; see FINDINGS.md.
[Unit]
Description=quire memory (org.quire.Memory1)
Documentation=man:memoryd(1)

[Service]
Type=dbus
BusName=org.quire.Memory1
ExecStart=/usr/libexec/quire/memoryd
# No loader variables from the session reach the daemon: porter gives its fixed caller role only
# to a unit that unsets them (applied after the manager environment and Environment=).
UnsetEnvironment=LD_PRELOAD LD_LIBRARY_PATH LD_AUDIT GCONV_PATH GIO_EXTRA_MODULES GTK_MODULES GTK_PATH GST_PLUGIN_PATH GST_PLUGIN_SYSTEM_PATH LIBGL_DRIVERS_PATH MESA_LOADER_DRIVER_OVERRIDE __EGL_VENDOR_LIBRARY_DIRS __EGL_VENDOR_LIBRARY_FILENAMES GBM_BACKENDS_PATH LIBVA_DRIVERS_PATH VK_ICD_FILENAMES VK_DRIVER_FILES VK_ADD_DRIVER_FILES VK_LAYER_PATH VK_ADD_LAYER_PATH VK_INSTANCE_LAYERS VK_LOADER_LAYERS_ENABLE
Restart=on-failure
RestartSec=2

NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX
LockPersonality=yes
MemoryDenyWriteExecute=yes
