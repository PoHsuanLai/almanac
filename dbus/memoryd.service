# memoryd as a systemd user unit (org.quire.Memory1 on the session bus).
#
# It needs no network (the bus is a unix socket; inferd is another daemon behind the bus) and
# writes only the memory directories, so the unit says so. memoryd also applies a Landlock policy
# to itself (the same directories, the session bus socket, nothing else), so outside systemd the
# daemon is confined by the kernel all the same. Paths are `-` prefixed because they do
# not exist before the first run.
#
# Forget (ALM-18) scrubs the live files only. Keep ~/.local/share/quire/memory out of snapshots
# and backups: make it its own btrfs subvolume (a snapshot of the parent does not descend into
# it) or list it in the snapshot tool's and the backup tool's excludes. A systemd unit cannot do
# this; see FINDINGS.md.
[Unit]
Description=quire memory (org.quire.Memory1)
Documentation=man:memoryd(1)

[Service]
Type=dbus
BusName=org.quire.Memory1
ExecStart=/usr/libexec/quire/memoryd
Restart=on-failure
RestartSec=2

PrivateNetwork=yes
PrivateTmp=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=-%h/.local/share/quire/memory -%h/.cache/quire/memory -%h/.config/quire -%t/quire/memory
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
LockPersonality=yes
MemoryDenyWriteExecute=yes
